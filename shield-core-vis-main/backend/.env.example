# ClimateShield Backend Environment Configuration
ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true

# Database Configuration (PostgreSQL + PostGIS)
# For local Docker: postgresql+psycopg://climateshield:climateshield@127.0.0.1:5432/climateshield
# Fallback to local SQLite when PostgreSQL is offline for rapid dev/test
DATABASE_URL=sqlite:///./climateshield_dev.db

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=climateshield
POSTGRES_USER=climateshield
POSTGRES_PASSWORD=climateshield

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Operational Parameters
DEFAULT_CITY_ID=city-vizag
RISK_SERVICE_STATUS=HEALTHY
WEATHER_SERVICE_STATUS=HEALTHY
IOT_SERVICE_STATUS=HEALTHY
GIS_SERVICE_STATUS=HEALTHY
